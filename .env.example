# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=sequence_user
POSTGRES_PASSWORD=sequence_pass
POSTGRES_DB=sequence_crm

# ── Backend ─────────────────────────────────────────────────────────────────
# Generate a strong random value: openssl rand -hex 32
SECRET_KEY=change-me-in-production
OPENAI_API_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Public URL of the backend reachable from the browser (not Docker network)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/
NEXT_PUBLIC_API_TIMEOUT=15000

# ── Port overrides (optional) ────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
